@startuml use-case
' Köprü — Use Case Diyagramı (taslak v0.1)
' Render: https://www.plantuml.com/plantuml veya VS Code PlantUML eklentisi
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Üye (öğrenci)" as Uye
actor "İş arayan" as Arayan
actor "Referans" as Ref
actor "Yönetici" as Yon
actor "Sistem\n(zamanlayıcı)" as Sys

Arayan --|> Uye

rectangle "Köprü" {
  usecase "Kayıt ol / giriş yap" as UC1
  usecase "Referans davet et" as UC2
  usecase "Daveti kabul et\nve rıza ver" as UC3
  usecase "E-posta / SMS ile\ndoğrula" as UC4
  usecase "Referans kriterlerini\nbelirle" as UC5
  usecase "Sektör ve pozisyon\nseçerek talep oluştur" as UC6
  usecase "CV yükle" as UC7
  usecase "Talep bildirimi al" as UC8
  usecase "Talebi kabul / reddet" as UC9
  usecase "Geri bildirim ver" as UC10
  usecase "Hesabı dondur /\nitirazı incele" as UC11
  usecase "Onaylanmayan daveti sil" as UC12
  usecase "Verimi indir /\nhesabımı sil" as UC13
}

Uye --> UC1
Uye --> UC2
Uye --> UC13
Arayan --> UC6
Arayan --> UC7
Ref --> UC3
Ref --> UC5
Ref --> UC8
Ref --> UC9
Ref --> UC10
Ref --> UC13
Yon --> UC11
Sys --> UC12
Sys --> UC8

UC3 ..> UC4 : <<include>>
UC6 ..> UC7 : <<include>>
UC9 ..> UC10 : <<extend>>
@enduml
